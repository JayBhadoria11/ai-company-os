# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it is ignored by .gitignore.

# Required: Nebius Token Factory API key (NVIDIA Nemotron models).
NEBIUS_API_KEY=

# Optional overrides.
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
